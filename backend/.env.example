# =====================================================================
#  ▶▶  ENTER YOUR MYSQL DETAILS HERE  ◀◀
#  This file stays on the server. Never commit it, never put these
#  values in the frontend. (It is already listed in .gitignore.)
# =====================================================================

# Where MySQL is running. "localhost" (or 127.0.0.1) for a local install.
DB_HOST=localhost

# MySQL port. 3306 is the default (XAMPP/MariaDB usually uses 3306 too).
DB_PORT=3306

# Your MySQL username and password.
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# The database created by sql/schema.sql (default: beam).
DB_NAME=beam

# ---------------------------------------------------------------------
#  Server settings
# ---------------------------------------------------------------------

# Secret used to sign login tokens. REQUIRED — at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API/web server listens on.
PORT=3000

# Only needed if the frontend is served from a DIFFERENT origin than the API
# (e.g. http://localhost:5173). Comma-separate multiple origins. Leave blank
# when Express serves the frontend itself (the default).
CORS_ORIGIN=
